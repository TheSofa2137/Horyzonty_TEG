# ── Horyzonty – environment configuration ─────────────────────────────────────
# Copy this file to  .env  and fill in your keys.
# The app works without API keys – it falls back to Neo4j / mock data.

# Duffel flight search (https://duffel.com – get your key at app.duffel.com)
# Test key starts with duffel_test_..., live key with duffel_live_...
DUFFEL_API_KEY=

# OpenWeatherMap 5-day forecast (optional – free tier at openweathermap.org)
OPENWEATHERMAP_API_KEY=

