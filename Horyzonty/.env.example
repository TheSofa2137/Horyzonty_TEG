# ── OpenWeatherMap ─────────────────────────────────────────────────────────────
# Free tier: https://openweathermap.org/api  (register → API keys)
# Provides 5-day / 3-hour forecast used by the Weather agent and Planner agent
OPENWEATHERMAP_API_KEY=your_key_here

# ── Duffel (flight search) ─────────────────────────────────────────────────────
# Free test account: https://app.duffel.com  (register → API → Create token)
# Test tokens start with duffel_test_..., live tokens with duffel_live_...
DUFFEL_API_KEY=your_duffel_api_key

# ── Neo4j ──────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PW=12345678

